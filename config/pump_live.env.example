# Copy this file to config/pump_live.env and edit only the local ignored copy.
# Never commit or send these credentials in chat/email.
BYBIT_PUMP_API_KEY=
BYBIT_PUMP_API_SECRET=
BYBIT_PUMP_SUB_UID=

# Prefer a dedicated master key with Wallet=AccountTransfer,SubMemberTransfer
# and no Withdraw.
# If omitted, preflight inspects BYBIT_API_KEY from the root .env and remains
# blocked unless that key has the required permission.
BYBIT_PUMP_MASTER_TRANSFER_API_KEY=
BYBIT_PUMP_MASTER_TRANSFER_API_SECRET=

# Prefer a dedicated Pump subaccount key with
# Wallet=AccountTransfer,SubMemberTransferList and no trading permissions.
# If omitted, preflight inspects the Pump trading key above and keeps the same
# least-privilege Wallet permission gate.
BYBIT_PUMP_SUB_TRANSFER_API_KEY=
BYBIT_PUMP_SUB_TRANSFER_API_SECRET=

# 0 = Bybit mainnet, 1 = Bybit testnet.
BYBIT_PUMP_TESTNET=0

# The software supports four positions, but the first live canary starts at one.
# Raise to 4 only after the first entry/add/TP/restart reconciliation is reviewed.
PUMP_LIVE_ENTRY_CAP=1
PUMP_LIVE_POLL_INTERVAL_SEC=15
PUMP_LIVE_MAX_SLIPPAGE_BPS=50

# Margin-only control. It does not change ladder count, prices, weights, or slot size.
# After L1, add the minimum isolated margin needed to keep the catastrophic stop
# this far above L2, rounded upward to $5, then keep it as a non-removable floor.
PUMP_LIVE_MARGIN_PREFUND_ENABLED=1
PUMP_LIVE_MARGIN_PREFUND_SAFETY_PCT=2.5
PUMP_LIVE_MARGIN_PREFUND_TOLERANCE_PCT=2.0

# Versioned margin manager. v2_current_next preserves the previous live
# behavior. v3_shared_projected keeps positions isolated, pools only the Pump
# USDT allocator, and prefunds both the current and projected post-fill stop
# beyond the following ladder before the next order can remain live.
PUMP_LIVE_MARGIN_MANAGER_POLICY=v2_current_next
PUMP_LIVE_PROJECTED_FINAL_FILL_BUFFER_PCT=20
PUMP_LIVE_SHARED_RESCUE_FACILITY_CAP_USD=2000
PUMP_LIVE_SHARED_MAX_POSITION_TOPUP_USD=2000

# Automatic warning-zone rescue remains limited to a live position inside the
# 20% warning band and above the 10% emergency boundary. The same guarded
# provider may also cover a confirmed next-ladder prefund cash shortfall before
# that ladder is recreated. Neither path funds a new entry. Both require the
# position/portfolio caps and a fresh safe main-account projection; at/below
# 10%, exchange stop/close handling stays authoritative.
PUMP_LIVE_AUTO_TRANSFER_ENABLED=0
PUMP_LIVE_AUTO_TRANSFER_MAIN_MIN_AVAILABLE_USD=500
PUMP_LIVE_AUTO_TRANSFER_MAIN_MAX_MARGIN_RATIO=0.75
PUMP_LIVE_AUTO_TRANSFER_MAIN_MIN_LIQ_BUFFER_PCT=25
PUMP_LIVE_AUTO_TRANSFER_MAIN_MAX_DATA_AGE_SEC=180
PUMP_LIVE_AUTO_TRANSFER_MAX_INCIDENT_USD=250
PUMP_LIVE_AUTO_TRANSFER_DAILY_ALERT_USD=500
PUMP_LIVE_AUTO_TRANSFER_ROUND_USD=5

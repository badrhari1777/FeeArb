    "expected_result": {"reconciled": false, "repair_required": false},
    "expected_rule": {"active_execution_id": "old-worker", "active_action": "exit", "status": "waiting_reconcile", "blocked_reason": "position_refresh_failed: positions unavailable", "next_eligible_ts": 130.0},
    "expected_event": {"event": "live_execution_state_missing_reconcile_deferred", "error": "positions unavailable"}
  }

      "id": "missing-balanced",
      "enabled": true,
      "chunk_qty": 100.0,
      "live_level": 1,
      "active_execution_id": "old-worker",
      "active_action": "enter",
      "pending_transition": {"action": "enter", "from_level": 1, "to_level": 2, "target_qty": 100.0, "filled_qty": 40.0, "remaining_qty": 60.0}
    },
    "quantities": {"hedged_qty": 140.0, "imbalance_qty": 0.0},
